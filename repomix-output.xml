  static toPersistence(domain: Partial<User>): Partial<TypeOrmUserEntity> {
    return {
      id: domain.id,
      username: domain.username,
      passwordHash: domain.passwordHash,
      name: domain.name,
      phone: domain.phone,
      address: domain.address,
      deletedAt: domain.deletedAt,
    };
  }
}
